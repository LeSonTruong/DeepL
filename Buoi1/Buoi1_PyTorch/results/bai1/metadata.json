{
  "dataset": "make_moons, n_samples=800, noise=0.25, random_state=42",
  "train_samples": 640,
  "validation_samples": 160,
  "epochs": 20,
  "seed": 42,
  "split": "random_split 80/20, generator seed=42",
  "scaling": "none (same as original code)",
  "train_batch_size": 32,
  "val_batch_size": 128,
  "optimizer": "torch.optim.Adam",
  "criterion": "torch.nn.CrossEntropyLoss",
